# ===== General =====
TZ=Europe/Zurich

# ===== API / admin =====
API_PORT=8080
ADMIN_USER=admin
# Required: at least 12 characters — anything shorter and the containers refuse to start
ADMIN_PASSWORD=
# Required: at least 32 characters, 64 random recommended:  openssl rand -hex 32
# Note: changing this invalidates every running admin session
SECRET_KEY=
# Set to 1 when the admin panel runs behind TLS (Caddy/reverse proxy) — session cookie via HTTPS only
SESSION_COOKIE_SECURE=0

# ===== Modem =====
# Host path of the AT port (interface 02!) — find it on the host with:  ls -l /dev/serial/by-id/
# Example: /dev/serial/by-id/usb-SimTech__Incorporated_SimTech__Incorporated_0123456789ABCDEF-if02-port0
HOST_MODEM_DEVICE=
# 1 = fake modem for development/tests without hardware (then comment out the devices block in docker-compose.yml)
MODEM_FAKE=0
# Send throttle in segments per minute (consumer SIM: keep it conservative)
MESSAGES_PER_MINUTE=6

# ===== API limits =====
# 0 = disabled
RATE_LIMIT_PER_MINUTE=0

# ===== Database =====
DATABASE_PATH=/data/gateway.db
